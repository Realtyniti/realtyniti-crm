# Supabase (leave both empty to run in demo mode with in-memory data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The old shared password. Since team logins it opens nothing; it is asked for once, to create the
# owner login on first setup (required in production until the owner exists).
ADMIN_PASSWORD=

# Shared key the website form handler sends as the x-intake-key header
INTAKE_SECRET=

# Meta lead ads webhook
META_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Page id -> brand buyers saw, e.g. 111=Tathya Homes,222=Realtyniti. Leads are greeted in that name.
META_PAGE_BRANDS=
# Optional per-Page token when a Page is not covered by META_PAGE_ACCESS_TOKEN: META_PAGE_ACCESS_TOKEN_<pageId>=

# WhatsApp Cloud API (Phase 2: Lead Catcher). Without these, messages are dry runs shown on the card.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta-registered message templates (names). Opener: {{1}} = buyer first name. Alert: {{1}} = alert text.
WHATSAPP_OPENER_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE=
# Follow-up Clock outside the 24h window: {{1}} = buyer first name
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Chetan's own WhatsApp number for hot-lead alerts and the 9 AM digest
CHETAN_WHATSAPP=

# Vercel Cron sends this as a Bearer token to /api/cron/digest
CRON_SECRET=

# Site Visit Booker (Phase 3): signs each buyer's personal booking link
BOOKING_SECRET=
APP_URL=https://realtyniti-crm.vercel.app

# New-lead alerts on phones (Web Push). Optional: left empty, the server derives a stable key pair from
# SUPABASE_SERVICE_ROLE_KEY. Set both to use your own (npx web-push generate-vapid-keys).
# Without them the CRM works normally and simply sends no alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://tathyahomes.com
