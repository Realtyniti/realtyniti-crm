# Supabase (leave both empty to run in demo mode with in-memory data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for every CRM screen (required in production)
ADMIN_PASSWORD=

# Shared key the website form handler sends as the x-intake-key header
INTAKE_SECRET=

# Meta lead ads webhook
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# WhatsApp Cloud API (Phase 2: Lead Catcher). Without these, messages are dry runs shown on the card.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta-registered message templates (names). Opener: {{1}} = buyer first name. Alert: {{1}} = alert text.
WHATSAPP_OPENER_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Chetan's own WhatsApp number for hot-lead alerts and the 9 AM digest
CHETAN_WHATSAPP=

# Vercel Cron sends this as a Bearer token to /api/cron/digest
CRON_SECRET=

# Site Visit Booker (Phase 3): signs each buyer's personal booking link
BOOKING_SECRET=
APP_URL=https://realtyniti-crm.vercel.app
